-- Функция создания красивых неоновых кнопок для вкладок
local function makeTabBtn(text, offset, tabName)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0.9, 0, 0, 40)
	b.Position = UDim2.new(0.05, 0, 0, 55 + offset)
	b.BackgroundColor3 = Color3.fromRGB(22, 24, 30)
	b.Text = text
	b.TextColor3 = Color3.fromRGB(160, 165, 175)
	b.TextSize = 13
	b.Font = Enum.Font.GothamSemibold
	b.Parent = Sidebar
	
	local bc = Instance.new("UICorner")
	bc.CornerRadius = UDim.new(0, 8)
	bc.Parent = b
	
	b.MouseButton1Click:Connect(function()
		for n, f in pairs(Tabs) do f.Visible = (n == tabName) end
	end)
end

